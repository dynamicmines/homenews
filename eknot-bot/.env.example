# --- Telegram ---
# Токен от @BotFather (команда /newbot)
BOT_TOKEN=

# Telegram user id владельца/модератора. Узнать свой id можно у бота @userinfobot.
# Можно перечислить несколько через запятую: 111111,222222
ADMIN_IDS=

# Публичный HTTPS-адрес, на котором будет открываться Mini App.
# Для локальной разработки — ссылка ngrok на порт этого бота (см. PORT ниже).
# Пример: https://abcd1234.ngrok-free.app
MINI_APP_URL=

# --- Strapi (eknot-cms) ---
# Адрес запущенного Strapi. Локально — обычно так и есть.
STRAPI_URL=http://localhost:1337

# API-токен Strapi с полным доступом.
# Создать: Strapi admin -> Settings -> API Tokens -> Create new API Token
# Token type: Full access
STRAPI_API_TOKEN=

# --- Bot server ---
# Порт, на котором работает Express-сервер бота (отдаёт Mini App и проксирует запросы к Strapi)
PORT=3001
