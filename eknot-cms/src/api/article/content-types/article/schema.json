{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "News"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "titleRu": {
      "type": "string"
    },
    "titleKz": {
      "type": "string"
    },
    "summaryRu": {
      "type": "string"
    },
    "summaryKz": {
      "type": "string"
    },
    "contentRu": {
      "type": "richtext"
    },
    "contentKz": {
      "type": "richtext"
    },
    "slug": {
      "type": "uid",
      "targetField": "titleRu"
    },
    "district": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "sourceUrl": {
      "type": "string"
    },
    "sourceImageUrl": {
      "type": "string"
    },
    "urgency": {
      "type": "enumeration",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "coverImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "isFeatured": {
      "type": "boolean"
    },
    "isImportant": {
      "type": "boolean"
    },
    "category": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::category.category"
    }
  }
}
