    },
    "originalText": {
      "type": "text"
    },
    "prompt": {
      "type": "text"
    },
    "generatedTitleRu": {
      "type": "string"
    },
    "generatedTitleKz": {
      "type": "string"
    },
    "generatedSummaryRu": {
      "type": "text"
    },
    "generatedSummaryKz": {
      "type": "text"
    },
    "generatedContentRu": {
      "type": "text"
