HOST=0.0.0.0
PORT=1337
# Заполняются автоматически командой `npm run setup:env` из корня проекта.
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Автопарсинг активных источников. По умолчанию: каждые 30 минут.
CRON_ENABLED=true
AUTO_PARSER_ENABLED=true
AUTO_PARSER_LIMIT=3
AUTO_PARSER_CRON=0 */5 * * * *
AUTO_PARSER_PROMPT=Сделай короткие городские новости для HomeNews. Пиши официально, понятно для жителей, без неподтвержденных фактов. Сохраняй все важные факты: даты, адреса, маршруты, ограничения, причины и рекомендации. Не используй фразы “смотрите в изображении” или “подробности на картинке”.
